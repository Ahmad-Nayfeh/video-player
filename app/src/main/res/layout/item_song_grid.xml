<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">

    <com.ahmadnayfeh.reel.RatioFrame
        android:id="@+id/thumbBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/folder_bg"
        android:tag="1.0">

        <ImageView android:id="@+id/thumb" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:importantForAccessibility="no" />

        <TextView android:id="@+id/badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|end" android:layout_margin="8dp" android:background="@drawable/pill_dark"
            android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="1dp" android:paddingBottom="1dp"
            android:textColor="#FFFFFF" android:textSize="11.5sp" android:textStyle="bold" />

        <ImageView android:id="@+id/playing" android:layout_width="30dp" android:layout_height="30dp"
            android:layout_gravity="top|end" android:layout_margin="8dp" android:background="@drawable/accent_circle"
            android:padding="7dp" android:src="@drawable/ic_volume" android:tint="@color/on_accent"
            android:visibility="gone" android:importantForAccessibility="no" />

        <ImageView android:id="@+id/check" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/sel_overlay" android:padding="36dp" android:src="@drawable/ic_check"
            android:tint="@color/accent" android:visibility="gone" android:importantForAccessibility="no" />
    </com.ahmadnayfeh.reel.RatioFrame>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="2dp">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="2" android:lineSpacingExtra="1dp" android:textColor="@color/ink"
                android:textSize="14sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/muted" android:textSize="12sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/more" android:layout_width="32dp" android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/more"
            android:src="@drawable/ic_more" android:tint="@color/muted" />
    </LinearLayout>
</LinearLayout>
