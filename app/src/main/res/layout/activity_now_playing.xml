<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton android:id="@+id/btnBack" style="@style/OverlayBtn" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:contentDescription="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/now_playing"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <ImageButton android:id="@+id/btnSleep" style="@style/OverlayBtn" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_timer" android:contentDescription="@string/sleep_timer" />
    </LinearLayout>

    <androidx.media3.ui.PlayerView
        android:id="@+id/pv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:artwork_display_mode="fit"
        app:default_artwork="@drawable/art_placeholder"
        app:show_timeout="0"
        app:hide_on_touch="false"
        app:use_controller="false" />

    <TextView
        android:id="@+id/songTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="@color/ink"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/songArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/muted"
        android:textSize="15sp" />

    <androidx.media3.ui.PlayerControlView
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:show_timeout="0"
        app:show_shuffle_button="true"
        app:repeat_toggle_modes="one|all" />
</LinearLayout>
