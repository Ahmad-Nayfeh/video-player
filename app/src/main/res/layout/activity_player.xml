<?xml version="1.0" encoding="utf-8"?>
<com.ahmadnayfeh.reel.GestureLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gestures"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/pv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:controller_layout_id="@layout/reel_controls"
        app:show_timeout="3500"
        app:animation_enabled="false" />

    <LinearLayout
        android:id="@+id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:background="@drawable/info_bg"
        android:gravity="center_vertical"
        android:minWidth="150dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ImageView android:id="@+id/infoIcon" android:layout_width="22dp" android:layout_height="22dp" android:tint="@android:color/white" android:importantForAccessibility="no" />

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/infoText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
            <ProgressBar android:id="@+id/infoBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="120dp"
                android:layout_height="4dp" android:layout_marginTop="6dp" android:max="100"
                android:progressBackgroundTint="#44FFFFFF" android:progressTint="@color/accent" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/resumeChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/info_bg"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnUnlock"
        style="@style/OverlayBtn"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="28dp"
        android:background="@drawable/info_bg"
        android:padding="15dp"
        android:contentDescription="@string/unlock"
        android:src="@drawable/ic_lock_w"
        android:visibility="gone" />
</com.ahmadnayfeh.reel.GestureLayout>
